/* =============================================================
   项目记录器 —— 界面样式模板
   清冷的蓝灰骨架 + 低饱和石青强调，风险色降饱和不打架。
   $token 由 theme.py 在运行时替换，改配色请改 theme.py，
   不要在这里写死颜色值。
   ============================================================= */

/* ===== 全局 ===== */
QWidget {
    background-color: $bg_win;
    color: $fg;
    font-family: "Microsoft YaHei UI", "Segoe UI", "PingFang SC", sans-serif;
    font-size: 13.5px;
}
QLabel {
    background: transparent;
}
QToolTip {
    background-color: $tooltip_bg;
    color: $tooltip_fg;
    border: none;
    border-radius: 4px;
    padding: 5px 9px;
}
#Root {
    background-color: $bg_win;
}

/* ===== 顶栏 ===== */
#ToolBar {
    background-color: $bg_panel;
}
#ToolTitle {
    font-size: 15px;
    font-weight: 600;
    color: $fg_strong;
}
#ToolMeta {
    font-size: 12px;
    color: $fg_dim;
}

/* ===== 按钮 ===== */
/* 普通按钮默认几乎隐形，指上去才显底色；
   工具栏上不需要每个按钮都时刻喊「我是个按钮」。 */
QToolButton#TextButton {
    background-color: transparent;
    color: $fg_soft;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 6px 14px;
    font-size: 12.5px;
}
QToolButton#TextButton:hover {
    background-color: $hover;
    color: $fg;
}
QToolButton#TextButton:pressed {
    background-color: $pressed;
}
QToolButton#TextButton:checked {
    background-color: $accent_wash;
    border: 1px solid $accent_edge;
    color: $accent_dim;
}
QToolButton#TextButton:disabled {
    color: $disabled_fg;
    background-color: transparent;
}

/* 分段切换（如时间范围、筛选档位） */
QToolButton#ScopeButton {
    background-color: transparent;
    color: $fg_dim;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 14px;
    font-size: 12.5px;
}
QToolButton#ScopeButton:hover {
    background-color: $hover;
    color: $fg;
}
QToolButton#ScopeButton:checked {
    background-color: $accent_wash;
    border: 1px solid $accent_edge;
    color: $accent_dim;
    font-weight: 600;
}

QPushButton#PrimaryButton {
    background-color: $accent;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px 22px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton#PrimaryButton:hover {
    background-color: $accent_dim;
}
QPushButton#PrimaryButton:pressed {
    background-color: $accent_deep;
}

QPushButton#GhostButton {
    background-color: transparent;
    color: $fg_soft;
    border: 1px solid $field_line;
    border-radius: 8px;
    padding: 8px 18px;
}
QPushButton#GhostButton:hover {
    background-color: $accent_wash;
    border-color: $accent_edge;
}

QPushButton#DangerButton {
    background-color: transparent;
    color: $warn;
    border: 1px solid $accent_edge;
    border-radius: 8px;
    padding: 8px 18px;
}
QPushButton#DangerButton:hover {
    background-color: $accent_wash;
}

/* ===== 输入 ===== */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: $field_bg;
    color: $fg;
    border: 1px solid $field_line;
    border-radius: 7px;
    padding: 7px 10px;
    selection-background-color: $selection;
    selection-color: $fg_strong;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: $line_input;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: $field_focus;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 16px;
    background-color: $btn_bg_off;
    border: none;
}

QComboBox, QDateEdit {
    background-color: $field_bg;
    color: $fg;
    border: 1px solid $field_line;
    border-radius: 7px;
    padding: 7px 10px;
}
QComboBox:hover, QDateEdit:hover {
    border-color: $line_input;
}
QComboBox::drop-down, QDateEdit::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: $bg_panel;
    border: 1px solid $line;
    selection-background-color: $accent_wash;
    selection-color: $fg_strong;
    outline: none;
}

/* ===== 主选项卡 ===== */
QTabWidget#RootTabs::pane {
    background-color: $bg_win;
    border: none;
}
QTabWidget#RootTabs QTabBar {
    background-color: $bg_panel;
}
QTabWidget#RootTabs QTabBar::tab {
    background-color: transparent;
    color: $fg_dim;
    padding: 10px 22px;
    margin-right: 2px;
    margin-top: 6px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    font-weight: 600;
}
QTabWidget#RootTabs QTabBar::tab:hover {
    background-color: $accent_wash;
}
QTabWidget#RootTabs QTabBar::tab:selected {
    background-color: $bg_win;
    color: $fg_strong;
}

/* 页内的次级选项卡 */
QTabWidget#InnerTabs::pane {
    background-color: $bg_panel;
    border: 1px solid $line;
    border-radius: 10px;
    top: -1px;
}
QTabWidget#InnerTabs QTabBar::tab {
    background-color: transparent;
    color: $fg_dim;
    padding: 8px 16px;
    margin-right: 4px;
    font-size: 12.5px;
    border-bottom: 2px solid transparent;
}
QTabWidget#InnerTabs QTabBar::tab:hover {
    color: $fg_soft;
}
QTabWidget#InnerTabs QTabBar::tab:selected {
    color: $fg;
    font-weight: 600;
    border-bottom: 2px solid $accent;
}

/* ===== 侧栏 ===== */
#SidePanel {
    background-color: $bg_panel;
    border-right: 1px solid $line;
}
#PanelHeading {
    font-size: 12px;
    font-weight: 600;
    color: $fg_dim;
    padding: 2px 2px 6px 2px;
}
#PanelHint {
    color: $fg_dim;
    font-size: 12px;
    padding: 2px;
}

/* 通用列表 */
QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
}
QListWidget::item {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid $line_hair;
    padding: 6px 8px;
    border-radius: 6px;
}
QListWidget::item:hover {
    background-color: $hover;
}
QListWidget::item:selected {
    background-color: $accent_wash;
    color: $fg_strong;
}

/* ===== 表格 ===== */
QTableWidget, QTableView {
    background-color: $bg_panel;
    border: none;
    color: $fg;
    selection-background-color: $accent_wash;
    selection-color: $fg_strong;
    gridline-color: transparent;
}
QTableWidget::item, QTableView::item {
    padding: 6px 4px;
    border-bottom: 1px solid $line_hair;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: $accent_wash;
    color: $fg_strong;
}
QHeaderView::section {
    background-color: $bg_panel;
    color: $fg_dim;
    padding: 8px 6px;
    border: none;
    border-bottom: 1px solid $line;
    font-weight: 600;
    font-size: 12px;
}
QTableCornerButton::section {
    background-color: $bg_panel;
    border: none;
}

/* ===== 卡片 ===== */
/* 驾驶舱和详情页里的信息块，靠边框和圆角分组，不靠分隔线 */
#Card {
    background-color: $bg_panel;
    border: 1px solid $line;
    border-radius: 10px;
}
#CardTitle {
    font-size: 12px;
    font-weight: 600;
    color: $fg_dim;
}
#CardValue {
    font-size: 22px;
    font-weight: 600;
    color: $fg_strong;
}
#CardUnit {
    font-size: 12px;
    color: $fg_dim;
}
#CardNote {
    font-size: 12px;
    color: $fg_dim;
}

/* 预测结论区：暖白底，和正文区一样，读起来像一张纸 */
#AdviceBox {
    background-color: $bg_read;
    border: 1px solid $bg_read_line;
    border-radius: 10px;
}
#AdviceHeadline {
    font-size: 14px;
    font-weight: 600;
    color: $fg_strong;
}
#AdviceReason {
    font-size: 12.5px;
    color: $fg_read;
}
#AdviceAction {
    font-size: 12.5px;
    color: $accent_dim;
}

/* 状态徽标 */
#Badge {
    border-radius: 9px;
    padding: 2px 10px;
    font-size: 11.5px;
    font-weight: 600;
}

/* ===== 图表容器 ===== */
#TrendChart, #BarChart {
    background-color: $bg_chart;
    border: 1px solid $line_soft;
    border-radius: 8px;
}

/* ===== 对话框 ===== */
QDialog {
    background-color: $bg_win;
}
#DialogHint {
    color: $fg_dim;
    font-size: 12px;
}
QDialogButtonBox QPushButton, QMessageBox QPushButton {
    background-color: $btn_bg;
    color: $fg_soft;
    border: 1px solid $line;
    border-radius: 7px;
    padding: 7px 18px;
    min-width: 68px;
}
QDialogButtonBox QPushButton:hover, QMessageBox QPushButton:hover {
    background-color: $hover;
}
QDialogButtonBox QPushButton:default {
    background-color: $accent;
    color: #ffffff;
    border-color: $accent;
}

/* ===== 菜单 ===== */
QMenuBar {
    background-color: $bg_panel;
    padding: 2px 6px;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 6px;
    color: $fg_soft;
}
QMenuBar::item:selected {
    background-color: $menu_hover;
}
QMenu {
    background-color: $bg_panel;
    border: 1px solid $line;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item {
    padding: 7px 26px 7px 14px;
    border-radius: 6px;
    color: $fg;
}
QMenu::item:selected {
    background-color: $menu_hover;
}
QMenu::item:disabled {
    color: $disabled_fg;
}
QMenu::separator {
    height: 1px;
    background-color: $line_soft;
    margin: 5px 8px;
}

/* ===== 计时条 ===== */
/* 常驻在选项卡和状态栏之间。用略暗的底色把它和内容区分开，
   但不用强调色——它在跑的时候靠时钟变蓝来提示，不靠整条染色。 */
#TimerBar {
    background-color: $bg_read;
    border-top: 1px solid $line;
}
#TimerClock {
    color: $fg_strong;
    font-size: 17px;
    font-weight: 600;
    font-family: Consolas, "Microsoft YaHei UI";
    padding: 0 4px;
}

/* ===== 状态栏 ===== */
#StatusBar {
    background-color: $bg_panel;
    border-top: 1px solid $line;
}
#StatusFile {
    color: $fg_soft;
    font-size: 12px;
}
#StatusMeta {
    color: $fg_dim;
    font-size: 12px;
}
#StatusHint {
    color: $fg_faint;
    font-size: 11px;
}

/* ===== 分隔条 ===== */
QSplitter::handle {
    background-color: transparent;
}
QSplitter::handle:hover {
    background-color: $accent_edge;
}

/* ===== 滚动条：细、无按钮 ===== */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: $scroll;
    border-radius: 4px;
    min-height: 36px;
}
QScrollBar::handle:vertical:hover {
    background: $scroll_hover;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: $scroll;
    border-radius: 4px;
    min-width: 36px;
}
QScrollBar::handle:horizontal:hover {
    background: $scroll_hover;
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}
